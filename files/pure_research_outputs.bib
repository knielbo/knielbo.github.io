@book{a4252eea43854ed0bd5617d37ae09905,  title     = "Special issue on evolutionary theories of religion",  abstract  = "Redaktionen af et temanummer i Journal for the Cognitive Science of Religion 4 (1) 2016: 1-90 med en r{\ae}kke bidrag som respons til en targetartikel skrevet af Jonathan H. Turner med titlen {"}Using Neurosociology and Evolutionary Sociology to Explain the Origin and Evolution of Religions{"}. Der er kommentarer fra Justin L. Barrett, Lloyd Black & Richard Sosis, Ronald Fischer, Stewart Elliott Guthrie, Henrik H{\o}gh-Olesen, Niels N. Johannsen, Radek Kundt, Aiyana K. Willard & Adam Baimel, efterfulgt af respons fra Turner med titlen {"}The Problem with Too Much Fidelity to the Modern Synthesis When Explaining the Origins and Evolution of the Social Universe.",  keywords  = "evolution og religion, kognitiv religionsvidenskab, religionssociologi, evolution{\ae}r sociologi, neurosociologi",  author    = "Ryan McKay",  editor    = "Geertz, {Armin W.} and Nielbo, {Kristoffer Laigaard}",  year      = "2016",  language  = "English",  series    = "Journal for the Cognitive Science of Religion",  publisher = "Equinox Publishing",  number    = "1",}


